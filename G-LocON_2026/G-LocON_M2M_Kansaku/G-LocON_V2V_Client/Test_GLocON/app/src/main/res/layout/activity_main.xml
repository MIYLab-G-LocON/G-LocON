<?xml version="1.0" encoding="utf-8"?>
<!--
    画面構成（ナビアプリ風）
    ・地図を全面に表示し，操作部品はその上に浮かべる
    ・上: 開始前は Peer ID 入力カード，開始後は状態カード（走行モード・参加中のグループ・つながっている車・離脱円）
    ・右: コンパス（地図の向き N↑/H↑/固定）とズーム
    ・下: 操作パネル（他の車の表示の切り替え＋ SUMO / SIM / 仮想位置 / 目的地 / 終了）。開始後に表示
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========================================================
         地図 (全面表示・最背面)
         ======================================================== -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================================
         上部：Peer ID 入力カード
         ステータスバーを避けるため marginTop=36dp
         STARTボタン押下後に visibility=GONE で非表示にする
         ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/inputCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="8dp"
        app:cardBackgroundColor="@color/panel_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/panel_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/compassCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <!-- 検索アイコン代わりの位置アイコン -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="18sp"
                android:paddingEnd="8dp" />

            <EditText
                android:id="@+id/peerId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Peer ID を入力"
                android:inputType="textPersonName"
                android:background="@null"
                android:textSize="15sp"
                android:textColor="#3C4043"
                android:textColorHint="#9AA0A6"
                android:singleLine="true" />

            <!-- START ボタン（カード内・右端） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/start"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="開始"
                android:textSize="14sp"
                android:letterSpacing="0.05"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/map_primary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ========================================================
         上部：状態カード（開始後に表示）
         1行目: 走行モード（GPS / 仮想走行 / SUMO車両）
         2行目: 参加中のグループ数・P2Pでつながっている車（実機／仮想）・離脱円の半径
         ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/panel_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/panel_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/compassCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- 走行モードの色（GPS=灰，仮想走行=青，SUMO=紫） -->
            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/mode_gps" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="現在地（GPS）"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/statusSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="グループ 0 ・ つながっている車 0"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ========================================================
         上部：目的地入力カード
         開始後に表示，設定後に閉じる（下の「目的地」ボタンで開き直せる）
         ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/routeCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/panel_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/panel_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@+id/statusCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏁 目的地を入力"
                android:textSize="13sp"
                android:textColor="#9AA0A6"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/destLat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="緯度 (例: 35.6580)"
                    android:inputType="numberDecimal|numberSigned"
                    android:background="@null"
                    android:textSize="14sp"
                    android:textColor="#3C4043"
                    android:textColorHint="#9AA0A6"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/destLng"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="経度 (例: 139.7016)"
                    android:inputType="numberDecimal|numberSigned"
                    android:background="@null"
                    android:textSize="14sp"
                    android:textColor="#3C4043"
                    android:textColorHint="#9AA0A6"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/routeButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="設定"
                    android:textSize="14sp"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/map_primary" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ========================================================
         右上：コンパス / カメラ方向切替ボタン
         HEAD UP ↔ NORTH UP を切り替える
         地図アプリではコンパスは右上が定番位置
         ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/compassCard"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/panel_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/panel_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/angle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="H↑"
            android:textSize="11sp"
            android:textColor="@color/btn_icon_tint"
            android:fontFamily="monospace"
            android:padding="0dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="#20000000" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ========================================================
         右下：ズームコントロール（+ / −）
         Google Maps・Apple Maps と同じ右下配置
         2つのボタンをカードでまとめてグループとして認識させる
         ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/zoomCard"
        android:layout_width="48dp"
        android:layout_height="104dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:layout_goneMarginBottom="32dp"
        app:cardBackgroundColor="@color/panel_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/panel_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ズームイン (+) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/plus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/btn_icon_tint"
                android:textColor="@color/btn_icon_tint"
                android:padding="0dp"
                app:cornerRadius="0dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="#20000000" />

            <!-- 区切り線 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- ズームアウト (−) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/minus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:icon="@drawable/ic_remove"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/btn_icon_tint"
                android:textColor="@color/btn_icon_tint"
                android:padding="0dp"
                app:cornerRadius="0dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="#20000000" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ========================================================
         下部：操作パネル（開始後に表示）
         上段: 他の車の表示（P2P / 全車両 / 実機 / なし）
         下段: SUMO / SIM / 仮想位置 / 目的地 / 終了
         ======================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/panel_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/panel_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="他の車の表示"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/displayToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/dispP2P">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dispP2P"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="P2P"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dispAll"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="全車両"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dispReal"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="実機"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dispNone"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="なし"
                    android:textSize="13sp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sumoButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="SUMO"
                    android:textSize="11sp"
                    android:textColor="@color/action_tint"
                    android:singleLine="true"
                    app:icon="@drawable/ic_car"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/action_tint"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="SIM"
                    android:textSize="11sp"
                    android:textColor="@color/action_tint"
                    android:singleLine="true"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/action_tint"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/virtPosButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="仮想位置"
                    android:textSize="11sp"
                    android:textColor="@color/action_tint"
                    android:singleLine="true"
                    app:icon="@drawable/ic_place"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/action_tint"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/destButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="目的地"
                    android:textSize="11sp"
                    android:textColor="@color/action_tint"
                    android:singleLine="true"
                    app:icon="@drawable/ic_flag"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/action_tint"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/end"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="終了"
                    android:textSize="11sp"
                    android:textColor="@color/btn_end_text"
                    android:singleLine="true"
                    app:icon="@drawable/ic_power"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/btn_end_text"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
